# WW: species whitelist admin commands (Content.Server/_WW/Administration/Commands/SpeciesWhitelistCommands.cs)
cmd-specieswhitelistadd-desc = Lets a player pick a whitelisted species.
cmd-specieswhitelistadd-help = Usage: specieswhitelistadd <username> <species ID>
cmd-specieswhitelistremove-desc = Stops a player picking a whitelisted species.
cmd-specieswhitelistremove-help = Usage: specieswhitelistremove <username> <species ID>
cmd-specieswhitelist-species-does-not-exist = There is no species with the ID {$species}.
cmd-specieswhitelist-hint-species = Species
cmd-specieswhitelist-not-whitelisted-species = Note: {$species} isn't a whitelisted species, so everyone can already pick it.
cmd-specieswhitelistadd-already = {$player} is already whitelisted for {$species}.
cmd-specieswhitelistadd-added = {$player} can now play {$species}.
cmd-specieswhitelistremove-not = {$player} wasn't whitelisted for {$species}.
cmd-specieswhitelistremove-removed = {$player} can no longer play {$species}.
